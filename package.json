{
  "name": "wow-assistant",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled --var LOCAL_DEV:1",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "addon:install": "node scripts/uploader.mjs --install",
    "addon:upload": "node scripts/uploader.mjs",
    "db:migrate:local": "wrangler d1 migrations apply wow-assistant --local",
    "db:migrate:remote": "wrangler d1 migrations apply wow-assistant --remote"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
