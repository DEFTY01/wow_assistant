{
  "name": "azeroth-mcp",
  "private": true,
  "type": "module",
  "description": "Local MCP bridge to World of Warcraft (Forever) SavedVariables and combat logs",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "azeroth-mcp": "src/cli.ts"
  },
  "scripts": {
    "serve": "node --no-warnings=ExperimentalWarning src/cli.ts serve",
    "ingest": "node --no-warnings=ExperimentalWarning src/cli.ts ingest",
    "doctor": "node --no-warnings=ExperimentalWarning src/cli.ts doctor",
    "install-addons": "node --no-warnings=ExperimentalWarning src/cli.ts install",
    "test": "node --no-warnings=ExperimentalWarning --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.6.10",
    "typescript": "^7.0.2"
  }
}
